# Application
APP_NAME=MMCS Social Network
DEBUG=true
VERSION=0.1.0

# Auth — verifies the Supabase session JWT on every API request (see
# CREDENTIALS.md, Tier 0). SUPABASE_URL is your project's URL, also used
# to fetch the public JWKS endpoint for projects using asymmetric
# (ES256/RS256) signing keys. SUPABASE_JWT_SECRET is only needed if your
# project still uses the legacy shared HS256 secret (Project Settings >
# API > JWT Settings) — leave blank for the newer asymmetric-key default,
# app/security/auth.py picks the right verification mode per-token.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=

# Media & Asset Library — Supabase Storage. This is a DIFFERENT key from
# the auth secret above: a server-side service-role key (Project Settings
# > API > service_role secret) that bypasses RLS, needed to upload/delete
# on the app's behalf — never expose this to the frontend. Create the
# bucket itself once by hand in Supabase's dashboard (Storage > New
# bucket) before uploads will work; this app doesn't auto-create it.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media-library
MEDIA_UPLOAD_MAX_BYTES=20000000

# Database (Supabase Postgres connection string, asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:your-password@your-project.supabase.co:5432/postgres

# Redis
REDIS_URL=redis://localhost:6379/0

# AI / LLM
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# LangSmith tracing for the LangGraph pipeline (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key

# Trend Analyzer
TREND_COLLECTION_INTERVAL_HOURS=6
# ISO country code (e.g. "US", "AU") for Google Trends; empty = worldwide
GOOGLE_TRENDS_REGION=
GOOGLE_TRENDS_SEED_KEYWORDS=["marketing","social media","AI"]

# Reddit — read-only OAuth via a free Reddit "script" app (reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your-reddit-app-client-id
REDDIT_CLIENT_SECRET=your-reddit-app-client-secret
REDDIT_SUBREDDITS=["marketing","socialmedia","smallbusiness"]
RSS_FEED_URLS=["https://feeds.feedburner.com/TechCrunch","https://www.socialmediatoday.com/feeds/news/"]
YOUTUBE_API_KEY=your-youtube-data-api-key
YOUTUBE_SEARCH_QUERIES=["marketing trends","social media strategy"]

# X / Twitter (needs a paid X API developer tier — free tier cannot search)
TWITTER_BEARER_TOKEN=your-x-api-bearer-token
TWITTER_SEARCH_QUERIES=["marketing trends","social media strategy"]

# Instagram (needs a Business/Creator account behind a Meta app)
INSTAGRAM_ACCESS_TOKEN=your-instagram-long-lived-access-token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-instagram-business-account-id
INSTAGRAM_HASHTAGS=["marketing","socialmedia"]

# TikTok (Research API — gated behind academic/institutional approval)
TIKTOK_CLIENT_KEY=your-tiktok-research-api-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-research-api-client-secret
TIKTOK_SEARCH_KEYWORDS=["marketing trends","social media"]

# Knowledge Base — Voyage AI embeddings (Anthropic-recommended, free 200M tokens/mo)
VOYAGE_API_KEY=your-voyage-api-key
VOYAGE_MODEL=voyage-3-lite

# Company Analyzer — max pages crawled per onboarding run
COMPANY_ONBOARDING_MAX_PAGES=10

# Content Management — Strategy Consultant + Content Planner
STRATEGY_MAX_TRENDS=10
CONTENT_PLAN_MAX_TRENDS=10
CONTENT_PLAN_DAYS=14

# Content Management — Campaign Manager + Brand Collaboration
COLLABORATION_MAX_IDEAS=5

# Social Media Analyzer — Platform Integration (OAuth via Composio, not
# raw OAuth code in this app). FRONTEND_BASE_URL is where the browser
# lands after a connection completes.
FRONTEND_BASE_URL=http://localhost:3000
# app.composio.dev account API key.
COMPOSIO_API_KEY=
# Each is a Composio "auth config" id (e.g. "ac_xxxx"), created via the
# Composio dashboard with `use_custom_auth` and that platform's own
# registered OAuth app client ID/secret pasted in there — not here.
# One Meta app can cover both Instagram and Facebook; use the same id in
# both settings if so.
COMPOSIO_INSTAGRAM_AUTH_CONFIG_ID=
COMPOSIO_FACEBOOK_AUTH_CONFIG_ID=
COMPOSIO_TWITTER_AUTH_CONFIG_ID=
COMPOSIO_LINKEDIN_AUTH_CONFIG_ID=
COMPOSIO_TIKTOK_AUTH_CONFIG_ID=
COMPOSIO_YOUTUBE_AUTH_CONFIG_ID=

# Social Media Analyzer — Publishing. Each is the Composio *tool slug* for
# that platform's "create a post" action (e.g. "LINKEDIN_CREATE_LINKEDIN_POST")
# — look it up in Composio's tool catalog for that toolkit once you have a
# real account; this app doesn't guess it, since an exact action slug can't
# be verified without live API access. Leave blank until confirmed.
COMPOSIO_INSTAGRAM_POST_TOOL_SLUG=
COMPOSIO_FACEBOOK_POST_TOOL_SLUG=
COMPOSIO_TWITTER_POST_TOOL_SLUG=
COMPOSIO_LINKEDIN_POST_TOOL_SLUG=
COMPOSIO_TIKTOK_POST_TOOL_SLUG=
COMPOSIO_YOUTUBE_POST_TOOL_SLUG=
# How often the scheduled-publishing job checks for due scheduled posts.
PUBLISH_SCHEDULER_INTERVAL_MINUTES=5

# Trend Analyzer — Trend Outputs
TREND_REPORT_MAX_TRENDS=15
TREND_REPORT_DEFAULT_PERIOD_DAYS=7
TREND_REPORT_MAX_CAMPAIGNS=5
TREND_REPORT_MAX_COMPETITORS=5

# Trend Analyzer — recommended trends
TREND_RECOMMENDATION_MIN_RELEVANCE=0.75
TREND_RECOMMENDATION_MAX_AGE_DAYS=7
TREND_RECOMMENDATION_LIMIT=10

# Trend Analyzer — scheduled daily trend report
TREND_DAILY_REPORT_INTERVAL_HOURS=24

# Knowledge Base — Knowledge Manager
KNOWLEDGE_AUDIT_MAX_DOCUMENTS=30

# Knowledge Base — document sources (blog indexer, uploads, dashboard)
KB_BLOG_MAX_ARTICLES=5
KB_DOCUMENT_LIST_DEFAULT_LIMIT=50
KB_UPLOAD_MAX_BYTES=5000000

# Knowledge Base — scheduled re-index
KB_REINDEX_INTERVAL_HOURS=24

# CORS
CORS_ORIGINS=["http://localhost:3000"]
