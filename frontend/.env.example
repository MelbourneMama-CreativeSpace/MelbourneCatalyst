# Backend API base URL — defaults to http://localhost:8000 if unset,
# only needs setting when frontend and backend aren't on the same host.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth (see CREDENTIALS.md, Tier 0) — Project Settings > API in
# your Supabase dashboard. Use the anon/public key, never service_role.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-project-anon-public-key
